# ==========================================
# 🚫 ARQUIVOS E PASTAS QUE NUNCA DEVEM SUBIR
# ==========================================

# Dependências e Pacotes (evita 10k+ arquivos)
node_modules/
npm-packages-offline-shim/
.pnpm-store/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Logs e Debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Testes e Relatórios de Cobertura
coverage/
.jest/
.nyc_output/
*.lcov

# Builds e Caches Temporários
dist/
build/
out/
.parcel-cache/
.eslintcache/
.cache/
tmp/
temp/

# Variáveis de Ambiente, Chaves e Credenciais
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# IDEs e Editores
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.settings/
.classpath

# Arquivos do Sistema Operacional (Windows / macOS / Linux)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
